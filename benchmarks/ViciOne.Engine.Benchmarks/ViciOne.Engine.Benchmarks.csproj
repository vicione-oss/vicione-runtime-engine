<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Benchmarks run on demand in Release config; excluded from normal CI test runs. -->
    <IsPublishable>false</IsPublishable>
    <!-- RuntimeIdentifiers are inherited from Directory.Build.props only for src/ projects;
         suppress here to avoid platform-specific restore noise for a dev-only tool. -->
    <RuntimeIdentifiers></RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ViciOne.Core.Dataflow\ViciOne.Core.Dataflow.csproj" />
    <ProjectReference Include="..\..\src\ViciOne.Engine\ViciOne.Engine.csproj" />
  </ItemGroup>

</Project>
