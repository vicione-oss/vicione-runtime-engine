# https://aka.ms/editorconfigdocs

# C# code style settings
#==============================
[*.cs]

# Implicit and explicit types
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:silent

# CA1050: Declare types in namespaces
dotnet_diagnostic.CA1050.severity = none

# CA1861: Avoid constant arrays as arguments
dotnet_diagnostic.CA1861.severity = none

# xUnit1044 + 1045: Avoid using TheoryData type arguments that might not be serializable
dotnet_diagnostic.xUnit1044.severity = none
dotnet_diagnostic.xUnit1045.severity = none

# CA1515: Consider making public types internal
# -> Die Basisklassen der Tests, die Hilfsmethoden und -typen enthalten, müssen auch public sein
dotnet_diagnostic.CA1515.severity = none
